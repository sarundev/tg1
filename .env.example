# ── Required ────────────────────────────────────────────────
# Get this from @BotFather -> /newbot (or /token for an existing bot)
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Banner image ────────────────────────────────────────────
# Either a local file inside assets/ ...
BANNER_PATH=assets/banner.jpg
# ... or a direct https URL (takes priority over BANNER_PATH if set)
BANNER_URL=

# ── Links used by the inline buttons ────────────────────────
REGISTER_URL=https://example.com/register
CHANNEL_URL=https://t.me/your_channel
SUPPORT_URL=https://t.me/your_support_account

# ── Bottom-left menu button (must be https, opens as a Mini App) ──
# Leave empty to show the default "commands" menu instead.
MENU_BUTTON_URL=https://example.com/register
MENU_BUTTON_TEXT=ចុះឈ្មោះ

# ── Optional: log every /start to this chat id (e.g. -1001234567890) ──
ADMIN_CHAT_ID=
